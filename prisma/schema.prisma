generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  MLB
  NFL
  NBA
  SOCCER
}

enum TradeSide {
  BUY
  SELL
}

enum LedgerType {
  SIGNUP_CREDIT
  TRADE_BUY
  TRADE_SELL
}

enum RealMarketEnvironment {
  SANDBOX
  LIVE
}

enum RealFundingType {
  DEPOSIT
  WITHDRAWAL
}

enum RealFundingRail {
  BANK
  DEBIT_CARD
  USDC_SOLANA
}

enum RealFundingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RealLedgerType {
  SANDBOX_DEPOSIT
  SANDBOX_WITHDRAWAL
  TRADE_BUY
  TRADE_SELL
  TRADE_FEE
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  username              String                    @unique
  passwordHash          String
  createdAt             DateTime                  @default(now())
  wallet                Wallet?
  positions             Position[]
  trades                Trade[]
  ledger                LedgerEntry[]
  sessions              Session[]
  watchlist             WatchlistEntry[]
  weeklyBaselines       WeeklyPortfolioBaseline[]
  realWallets           RealWallet[]
  realPositions         RealPosition[]
  realTrades            RealTrade[]
  realLedger            RealLedgerEntry[]
  realFundingTransactions RealFundingTransaction[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(5000) @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id           String   @id @default(cuid())
  providerKey  String?  @unique
  dataProvider String   @default("seed")
  sport        Sport
  league       String
  name         String
  abbreviation String
  city         String?
  conference   String?
  division     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([sport, abbreviation])
  @@index([sport, active])
}

model Athlete {
  id                String                  @id @default(cuid())
  providerKey       String?                 @unique
  dataProvider      String                  @default("seed")
  name              String
  slug              String                  @unique
  sport             Sport
  league            String
  team              String
  position          String
  currentPrice      Decimal                 @db.Decimal(18, 2)
  previousPrice     Decimal                 @db.Decimal(18, 2)
  performance       Int                     @default(50)
  marketCap         Decimal                 @default(0) @db.Decimal(18, 2)
  active            Boolean                 @default(true)
  marketEnabled     Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  positions         Position[]
  trades            Trade[]
  priceHistory      PriceSnapshot[]
  performanceValues PerformanceValueEvent[]
  watchlistedBy     WatchlistEntry[]
  realPositions     RealPosition[]
  realTrades        RealTrade[]
  @@index([sport, active, marketEnabled])
  @@index([sport, marketCap])
}

model Position {
  id          String   @id @default(cuid())
  userId      String
  athleteId   String
  quantity    Decimal  @db.Decimal(18, 4)
  averageCost Decimal  @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId])
  @@index([userId])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  athleteId   String
  side        TradeSide
  quantity    Decimal   @db.Decimal(18, 4)
  price       Decimal   @db.Decimal(18, 4)
  total       Decimal   @db.Decimal(18, 2)
  realizedPnl Decimal   @default(0) @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([athleteId, createdAt])
}

model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  type      LedgerType
  amount    Decimal    @db.Decimal(18, 2)
  balance   Decimal    @db.Decimal(18, 2)
  reference String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  athleteId String
  price     Decimal  @db.Decimal(18, 4)
  source    String   @default("pricing-engine")
  createdAt DateTime @default(now())
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, createdAt])
}

model PerformanceValueEvent {
  id        String   @id @default(cuid())
  athleteId String
  sport     Sport
  gameId    Int
  value     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([athleteId, gameId])
  @@index([athleteId, createdAt])
  @@index([sport, gameId])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  athleteId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId])
  @@index([userId, createdAt])
  @@index([athleteId])
}

model WeeklyPortfolioBaseline {
  id         String   @id @default(cuid())
  userId     String
  weekStart  DateTime
  startValue Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, weekStart])
  @@index([weekStart, startValue])
}

model RealWallet {
  id          String                @id @default(cuid())
  userId      String
  environment RealMarketEnvironment
  currency    String                @default("USD")
  balance     Decimal               @default(0) @db.Decimal(18, 2)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, environment])
  @@index([environment, updatedAt])
}

model RealPosition {
  id          String                @id @default(cuid())
  userId      String
  athleteId   String
  environment RealMarketEnvironment
  quantity    Decimal               @db.Decimal(18, 4)
  averageCost Decimal               @db.Decimal(18, 4)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId, environment])
  @@index([userId, environment])
  @@index([athleteId, environment])
}

model RealTrade {
  id          String                @id @default(cuid())
  userId      String
  athleteId   String
  environment RealMarketEnvironment
  side        TradeSide
  quantity    Decimal               @db.Decimal(18, 4)
  price       Decimal               @db.Decimal(18, 4)
  gross       Decimal               @db.Decimal(18, 2)
  fee         Decimal               @db.Decimal(18, 2)
  netCashFlow Decimal               @db.Decimal(18, 2)
  realizedPnl Decimal               @default(0) @db.Decimal(18, 2)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@index([userId, environment, createdAt])
  @@index([athleteId, environment, createdAt])
}

model RealLedgerEntry {
  id          String                @id @default(cuid())
  userId      String
  environment RealMarketEnvironment
  type        RealLedgerType
  amount      Decimal               @db.Decimal(18, 2)
  balance     Decimal               @db.Decimal(18, 2)
  reference   String?
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, environment, createdAt])
  @@index([reference])
}

model RealFundingTransaction {
  id              String                @id @default(cuid())
  userId          String
  environment     RealMarketEnvironment
  type            RealFundingType
  rail            RealFundingRail
  status          RealFundingStatus
  amount          Decimal               @db.Decimal(18, 2)
  asset           String                @default("USD")
  network         String?
  providerRef     String?
  externalAddress String?
  failureReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  completedAt     DateTime?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, environment, createdAt])
  @@index([status, environment])
  @@index([providerRef])
}
