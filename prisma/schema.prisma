generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  MLB
  NFL
  NBA
  SOCCER
}

enum TradeSide {
  BUY
  SELL
}

enum LedgerType {
  SIGNUP_CREDIT
  TRADE_BUY
  TRADE_SELL
}

enum RealMarketEnvironment {
  SANDBOX
  LIVE
}

enum RealFundingType {
  DEPOSIT
  WITHDRAWAL
}

enum RealFundingRail {
  BANK
  DEBIT_CARD
  USDC_SOLANA
}

enum RealFundingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RealLedgerType {
  SANDBOX_DEPOSIT
  SANDBOX_WITHDRAWAL
  TRADE_BUY
  TRADE_SELL
  TRADE_FEE
  RETIREMENT_SETTLEMENT
}

enum RealInstrumentStatus {
  ACTIVE
  HALTED
  RETIRING
  SETTLED
  RETIRED
}

enum LiquidityProviderStatus {
  SANDBOX_ACTIVE
  SUSPENDED
}

enum LiquidityQuoteSide {
  BID
  ASK
}

enum LiquidityQuoteStatus {
  ACTIVE
  CANCELLED
  FILLED
  EXPIRED
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  username                String                    @unique
  passwordHash            String
  createdAt               DateTime                  @default(now())
  wallet                  Wallet?
  positions               Position[]
  trades                  Trade[]
  ledger                  LedgerEntry[]
  sessions                Session[]
  watchlist               WatchlistEntry[]
  weeklyBaselines         WeeklyPortfolioBaseline[]
  realWallets             RealWallet[]
  realPositions           RealPosition[]
  realTrades              RealTrade[]
  realLedger              RealLedgerEntry[]
  realFundingTransactions RealFundingTransaction[]
  liquidityFills          LiquidityFill[]
  accountFrozen           Boolean                   @default(false)
  leaderboardEligible     Boolean                   @default(true)
  realEnrollment          RealEnrollment?
  rewardClaims            RewardClaim[]
  tradeRequests           TradeRequest[]
  passwordResetTokens     PasswordResetToken[]
  scoutWallet             ScoutWallet?
  scoutPositions          ScoutPosition[]
  scoutOrders             ScoutOrder[]
  scoutLedger             ScoutLedgerEntry[]
  scoutCashTransfers      ScoutCashTransfer[]
  scoutInventoryGrants    ScoutInventoryGrant[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(5000) @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id           String   @id @default(cuid())
  providerKey  String?  @unique
  dataProvider String   @default("seed")
  sport        Sport
  league       String
  name         String
  abbreviation String
  city         String?
  conference   String?
  division     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([sport, abbreviation])
  @@index([sport, active])
}

model Athlete {
  id                    String                  @id @default(cuid())
  providerKey           String?                 @unique
  dataProvider          String                  @default("seed")
  name                  String
  slug                  String                  @unique
  sport                 Sport
  league                String
  team                  String
  position              String
  currentPrice          Decimal                 @db.Decimal(18, 2)
  previousPrice         Decimal                 @db.Decimal(18, 2)
  performance           Int                     @default(50)
  marketCap             Decimal                 @default(0) @db.Decimal(18, 2)
  active                Boolean                 @default(true)
  marketEnabled         Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  positions             Position[]
  trades                Trade[]
  priceHistory          PriceSnapshot[]
  performanceValues     PerformanceValueEvent[]
  watchlistedBy         WatchlistEntry[]
  realPositions         RealPosition[]
  realTrades            RealTrade[]
  realMarketInstruments RealMarketInstrument[]
  scoutPositions        ScoutPosition[]
  scoutOrders           ScoutOrder[]
  scoutInventoryGrants  ScoutInventoryGrant[]
  @@index([sport, active, marketEnabled])
  @@index([sport, marketCap])
}

model Position {
  id          String   @id @default(cuid())
  userId      String
  athleteId   String
  quantity    Decimal  @db.Decimal(18, 4)
  averageCost Decimal  @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId])
  @@index([userId])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  athleteId   String
  side        TradeSide
  quantity    Decimal   @db.Decimal(18, 4)
  price       Decimal   @db.Decimal(18, 4)
  total       Decimal   @db.Decimal(18, 2)
  realizedPnl Decimal   @default(0) @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([athleteId, createdAt])
}

model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  type      LedgerType
  amount    Decimal    @db.Decimal(18, 2)
  balance   Decimal    @db.Decimal(18, 2)
  reference String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  athleteId String
  price     Decimal  @db.Decimal(18, 4)
  source    String   @default("pricing-engine")
  createdAt DateTime @default(now())
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@index([athleteId, createdAt])
}

model PerformanceValueEvent {
  id        String   @id @default(cuid())
  athleteId String
  sport     Sport
  gameId    Int
  value     Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([athleteId, gameId])
  @@index([athleteId, createdAt])
  @@index([sport, gameId])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  athleteId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId])
  @@index([userId, createdAt])
  @@index([athleteId])
}

model WeeklyPortfolioBaseline {
  id         String   @id @default(cuid())
  userId     String
  weekStart  DateTime
  startValue Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, weekStart])
  @@index([weekStart, startValue])
}

model RealWallet {
  id          String                @id @default(cuid())
  userId      String
  environment RealMarketEnvironment
  currency    String                @default("USD")
  balance     Decimal               @default(0) @db.Decimal(18, 2)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, environment])
  @@index([environment, updatedAt])
}

model RealPosition {
  id          String                @id @default(cuid())
  userId      String
  athleteId   String
  environment RealMarketEnvironment
  quantity    Decimal               @db.Decimal(18, 4)
  averageCost Decimal               @db.Decimal(18, 4)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  @@unique([userId, athleteId, environment])
  @@index([userId, environment])
  @@index([athleteId, environment])
}

model RealTrade {
  id          String                @id @default(cuid())
  userId      String
  athleteId   String
  environment RealMarketEnvironment
  side        TradeSide
  quantity    Decimal               @db.Decimal(18, 4)
  price       Decimal               @db.Decimal(18, 4)
  gross       Decimal               @db.Decimal(18, 2)
  fee         Decimal               @db.Decimal(18, 2)
  netCashFlow Decimal               @db.Decimal(18, 2)
  realizedPnl Decimal               @default(0) @db.Decimal(18, 2)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete     Athlete               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@index([userId, environment, createdAt])
  @@index([athleteId, environment, createdAt])
}

model RealLedgerEntry {
  id          String                @id @default(cuid())
  userId      String
  environment RealMarketEnvironment
  type        RealLedgerType
  amount      Decimal               @db.Decimal(18, 2)
  balance     Decimal               @db.Decimal(18, 2)
  reference   String?
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, environment, createdAt])
  @@index([reference])
}

model RealFundingTransaction {
  id              String                @id @default(cuid())
  userId          String
  environment     RealMarketEnvironment
  type            RealFundingType
  rail            RealFundingRail
  status          RealFundingStatus
  amount          Decimal               @db.Decimal(18, 2)
  asset           String                @default("USD")
  network         String?
  providerRef     String?
  externalAddress String?
  failureReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  completedAt     DateTime?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, environment, createdAt])
  @@index([status, environment])
  @@index([providerRef])
}

model RealMarketInstrument {
  id                      String                @id @default(cuid())
  athleteId               String
  environment             RealMarketEnvironment
  status                  RealInstrumentStatus @default(ACTIVE)
  referencePrice          Decimal               @db.Decimal(18, 4)
  frozenSettlementPrice   Decimal?              @db.Decimal(18, 4)
  retirementDeadline      DateTime?
  retirementReason        String?
  launchRank              Int?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  athlete                 Athlete               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  quotes                  LiquidityQuote[]
  providerInventory       LiquidityProviderInventory[]
  fills                   LiquidityFill[]
  settlementEvents        RealSettlementEvent[]
  @@unique([athleteId, environment])
  @@index([environment, status])
  @@index([environment, retirementDeadline])
}

model LiquidityProvider {
  id                    String                   @id @default(cuid())
  code                  String                   @unique
  name                  String
  environment           RealMarketEnvironment
  status                LiquidityProviderStatus  @default(SANDBOX_ACTIVE)
  makerFee              Decimal                  @default(0) @db.Decimal(8, 4)
  maxSpreadBps          Int                      @default(500)
  minQuoteDepth         Decimal                  @default(100) @db.Decimal(18, 2)
  maxGrossExposure      Decimal                  @default(100000) @db.Decimal(18, 2)
  maxPerAthleteExposure Decimal                  @default(10000) @db.Decimal(18, 2)
  quoteTtlSeconds       Int                      @default(30)
  lastHeartbeatAt       DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  apiKeys               LiquidityProviderApiKey[]
  wallet                LiquidityProviderWallet?
  inventory             LiquidityProviderInventory[]
  quotes                LiquidityQuote[]
  fills                 LiquidityFill[]
  @@index([environment, status])
}

model LiquidityProviderApiKey {
  id          String            @id @default(cuid())
  providerId  String
  keyPrefix   String
  keyHash     String            @unique
  ipAllowlist String[]
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())
  provider    LiquidityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([providerId, revokedAt])
}

model LiquidityProviderWallet {
  id         String            @id @default(cuid())
  providerId String            @unique
  balance    Decimal           @default(0) @db.Decimal(18, 2)
  updatedAt  DateTime          @updatedAt
  provider   LiquidityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model LiquidityProviderInventory {
  id           String               @id @default(cuid())
  providerId   String
  instrumentId String
  quantity     Decimal              @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime             @updatedAt
  provider     LiquidityProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  instrument   RealMarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  @@unique([providerId, instrumentId])
  @@index([instrumentId])
}

model LiquidityQuote {
  id           String               @id @default(cuid())
  providerId   String
  instrumentId String
  side         LiquidityQuoteSide
  price        Decimal              @db.Decimal(18, 4)
  quantity     Decimal              @db.Decimal(18, 4)
  remaining    Decimal              @db.Decimal(18, 4)
  status       LiquidityQuoteStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  provider     LiquidityProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  instrument   RealMarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  fills        LiquidityFill[]
  @@unique([providerId, instrumentId, side])
  @@index([instrumentId, side, status, expiresAt])
  @@index([providerId, status])
}

model LiquidityFill {
  id               String               @id @default(cuid())
  quoteId          String
  providerId       String
  instrumentId     String
  customerUserId   String?
  side             LiquidityQuoteSide
  quantity         Decimal              @db.Decimal(18, 4)
  price            Decimal              @db.Decimal(18, 4)
  gross            Decimal              @db.Decimal(18, 2)
  providerCashFlow Decimal              @db.Decimal(18, 2)
  createdAt        DateTime             @default(now())
  quote            LiquidityQuote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  provider         LiquidityProvider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  instrument       RealMarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  customer         User?                @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  @@index([providerId, createdAt])
  @@index([instrumentId, createdAt])
  @@index([customerUserId, createdAt])
}

model RealSettlementReserve {
  id          String                @id @default(cuid())
  environment RealMarketEnvironment @unique
  balance     Decimal               @default(0) @db.Decimal(18, 2)
  updatedAt   DateTime              @updatedAt
}

model RealSettlementEvent {
  id           String               @id @default(cuid())
  instrumentId String
  amount       Decimal              @db.Decimal(18, 2)
  holders      Int
  createdAt    DateTime             @default(now())
  instrument   RealMarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  @@index([instrumentId, createdAt])
}

// Foundation 4: no documents, birthdates, bank details, or raw identity tokens.
model RealEnrollment {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("PENDING")
  environment     RealMarketEnvironment @default(SANDBOX)
  identityHash    String?  @unique
  providerRef     String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model RewardClaim {
  id           String   @id @default(cuid())
  userId       String
  campaign     String
  identityHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([campaign, identityHash])
  @@unique([campaign, userId])
}

model AdminAuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  reason    String
  details   Json
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([targetId, createdAt])
}

model RateLimitWindow {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)
  @@unique([key, windowStart])
  @@index([windowStart])
}

model BetaControl {
  id                String   @id @default("global")
  freeTradingPaused Boolean  @default(false)
  sandboxPaused     Boolean  @default(false)
  message           String   @default("Trading is temporarily paused. Please try again later.")
  updatedAt         DateTime @updatedAt
}

model TradeRequest {
  id          String   @id @default(cuid())
  userId      String
  requestKey  String
  fingerprint String
  tradeId     String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestKey])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

// Customer matching sandbox has separate balances from legacy reference/LP simulators.
enum ScoutOrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELED
}

model ScoutWallet {
  id           String @id @default(cuid())
  userId       String @unique
  environment  RealMarketEnvironment @default(SANDBOX)
  balance      Decimal @default(0) @db.Decimal(18, 2)
  reservedCash Decimal @default(0) @db.Decimal(18, 2)
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScoutPosition {
  id               String @id @default(cuid())
  userId           String
  athleteId        String
  environment      RealMarketEnvironment @default(SANDBOX)
  quantity         Decimal @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal @default(0) @db.Decimal(18, 4)
  costBasis        Decimal @default(0) @db.Decimal(18, 2)
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete          Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@unique([userId, athleteId])
}

model ScoutOrder {
  id           String @id @default(cuid())
  sequence     BigInt @unique @default(autoincrement())
  userId       String
  athleteId    String
  environment  RealMarketEnvironment @default(SANDBOX)
  side         TradeSide
  status       ScoutOrderStatus @default(OPEN)
  price        Decimal @db.Decimal(18, 2)
  quantity     Decimal @db.Decimal(18, 4)
  remaining    Decimal @db.Decimal(18, 4)
  cashHold     Decimal @default(0) @db.Decimal(18, 2)
  feePaid      Decimal @default(0) @db.Decimal(18, 2)
  requestKey   String
  fingerprint  String
  cancelReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)
  athlete      Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  buyFills     ScoutFill[] @relation("ScoutBuyOrder")
  sellFills    ScoutFill[] @relation("ScoutSellOrder")
  @@unique([userId, requestKey])
  @@index([athleteId, side, status, price, sequence])
  @@index([userId, status])
}

model ScoutFill {
  id          String @id @default(cuid())
  environment RealMarketEnvironment @default(SANDBOX)
  buyOrderId  String
  sellOrderId String
  quantity    Decimal @db.Decimal(18, 4)
  price       Decimal @db.Decimal(18, 2)
  gross       Decimal @db.Decimal(18, 2)
  buyFee      Decimal @db.Decimal(18, 2)
  sellFee     Decimal @db.Decimal(18, 2)
  sellerPnl   Decimal @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  buyOrder    ScoutOrder @relation("ScoutBuyOrder", fields: [buyOrderId], references: [id], onDelete: Restrict)
  sellOrder   ScoutOrder @relation("ScoutSellOrder", fields: [sellOrderId], references: [id], onDelete: Restrict)
  @@index([createdAt])
}

model ScoutLedgerEntry {
  id            String @id @default(cuid())
  sequence      BigInt @unique @default(autoincrement())
  userId        String
  environment   RealMarketEnvironment @default(SANDBOX)
  type          String
  amount        Decimal @db.Decimal(18, 2)
  balance       Decimal @db.Decimal(18, 2)
  reservedAfter Decimal @db.Decimal(18, 2)
  reference     String
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, sequence])
}

model ScoutCashTransfer {
  id          String @id @default(cuid())
  userId      String
  environment RealMarketEnvironment @default(SANDBOX)
  type        RealFundingType
  amount      Decimal @db.Decimal(18, 2)
  requestKey  String
  fingerprint String
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
}

model ScoutInventoryGrant {
  id          String @id @default(cuid())
  userId      String
  athleteId   String
  environment RealMarketEnvironment @default(SANDBOX)
  quantity    Decimal @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  @@unique([userId, athleteId])
}
