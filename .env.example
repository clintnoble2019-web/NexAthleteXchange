DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexathletexchange?schema=public"
SESSION_COOKIE_NAME="nax_session"
BALLDONTLIE_API_KEY=""

# Foundation 4: configure existing account IDs; no signup admin role.
ADMIN_USER_IDS=""
APP_ORIGIN="http://localhost:3000"
REAL_MARKET_SANDBOX_PREVIEW="0"
REAL_MARKET_CUSTOMER_TEST="0"
TRUST_PROXY_IP="0"
AUTH_EMAIL_WEBHOOK_URL=""
AUTH_EMAIL_WEBHOOK_TOKEN=""

# Real Market production compliance gates. These are readiness indicators only;
# they do not themselves enable live funds or establish jurisdictional eligibility.
REAL_MARKET_LIVE_APPROVED="0"
REAL_MARKET_KYC_PROVIDER_ENABLED="0"
REAL_MARKET_SANCTIONS_SCREENING_ENABLED="0"
REAL_MARKET_GEOLOCATION_ENABLED="0"
REAL_MARKET_PAYMENT_CUSTODY_PROVIDER_ENABLED="0"
# Comma-separated jurisdiction allowlist, e.g. US-CA,US-NV. Leave empty in sandbox only.
REAL_MARKET_ALLOWED_REGIONS=""

# Persona KYC / age / sanctions / location verification.
# Use a Persona Sandbox API key and Sandbox Dynamic Flow template during testing.
# The selected Dynamic Flow must only emit APPROVED after the required identity/KYC,
# 18+ age, sanctions/watchlist, and operator-defined eligibility checks pass.
# NexGame also evaluates Persona inquiry-session network/location signals before unlocking access.
PERSONA_API_KEY=""
PERSONA_INQUIRY_TEMPLATE_ID=""
PERSONA_WEBHOOK_SECRET=""
PERSONA_API_VERSION="2025-10-27"
PERSONA_API_BASE="https://api.withpersona.com/api/v1"
PERSONA_HOSTED_FLOW_ORIGIN="https://inquiry.withpersona.com/verify"

# Circle developer-controlled Wallets. TESTNET ONLY while liveFundsEnabled=false.
# Generate/register the entity secret yourself in Circle and keep its recovery file outside this repo.
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""
CIRCLE_WALLET_SET_ID=""
CIRCLE_USDC_TOKEN_ID=""
CIRCLE_BLOCKCHAIN="SOL-DEVNET"
CIRCLE_API_BASE="https://api.circle.com"
CIRCLE_WEBHOOK_ENABLED="0"
CIRCLE_COMPLIANCE_SCREENING_ENABLED="0"
# Pooled test settlement wallet used as the source for withdrawals.
CIRCLE_SETTLEMENT_WALLET_ID=""
CIRCLE_SOL_GAS_SPONSORED="0"
